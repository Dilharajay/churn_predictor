# ==============================================================================
# Data & Cache (Cloud-first: raw/processed stored in S3)
# ==============================================================================
# Ignore processed, validated, and rejected data files, preserving .gitkeep placeholders
data/processed/*
!data/processed/.gitkeep
data/rejected/*
!data/rejected/.gitkeep
data/validated/*
!data/validated/.gitkeep

# Ignore Kaggle download cache and temporary files in raw
data/raw/.complete/
data/raw/*.tmp

# Temporary logs
logs/
*.log

